[Unit]
Description=PantryChef (gunicorn)
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/pantrychef
EnvironmentFile=/home/ubuntu/pantrychef/.env
ExecStart=/home/ubuntu/pantrychef/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
