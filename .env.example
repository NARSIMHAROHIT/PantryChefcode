# Copy to ".env" and fill in. .env is gitignored — never commit real secrets.

# Flask session signing key — set to a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Database. Leave unset for local SQLite (zero setup).
# In production (EC2 + PostgreSQL) use something like:
# DATABASE_URL=postgresql://pantry:yourpassword@localhost:5432/pantrychef

# ---- Optional email alerts (alerts.py). Leave blank to just print to console ----
ALERT_WINDOW_DAYS=3
ALERT_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
